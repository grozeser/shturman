# Порт на вашем компьютере (внутри контейнера приложение всегда слушает 8080)
APP_PORT=8080

# База данных (Postgres в docker compose)
POSTGRES_DB=shturman
POSTGRES_USER=shturman
POSTGRES_PASSWORD=shturman

# LLM в формате OpenAI — необязательно. Пусто = агент работает на правилах, весь путь до покупки доступен.
# Примеры:
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-4.1-mini
#   Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=qwen2.5:7b
#   Своя локальная модель в Docker: docker compose -f docker-compose.yml -f docker-compose.local-llm.yml up --build
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Модель для docker-compose.local-llm.yml (Ollama)
LOCAL_LLM_MODEL=qwen3:4b-instruct
LLM_TIMEOUT_SECONDS=30
# true — LLM переписывает ответы живым языком (числа проверяются), false — только разбор запроса
LLM_NARRATE=true

# Telegram-бот — необязательно (docker compose --profile telegram up --build)
TELEGRAM_BOT_TOKEN=

# Фиксированная «сегодняшняя» дата для воспроизводимого демо, формат YYYY-MM-DD. Пусто = реальная дата.
TODAY=
LOG_LEVEL=INFO
